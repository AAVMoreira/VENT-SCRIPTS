local function enableAntiKick()
	pcall(function()
		if hookmetamethod and not _G._FAGAntiKickHooked then
			_G._FAGAntiKickHooked = true
			local old
			old = hookmetamethod(game, "__namecall", function(self, ...)
				local method = (getnamecallmethod and getnamecallmethod()) or ""
				if tostring(method) == "Kick" and (self == LP or (typeof(self) == "Instance" and self:IsA("Player") and self == LP)) then
					return
				end
				return old(self, ...)
			end)
		end
	end)
	pcall(function()
		if hookfunction and not _G._FAGKickFnHooked then
			_G._FAGKickFnHooked = true
			local oldKick = LP.Kick
			if typeof(oldKick) == "function" then
				hookfunction(oldKick, function()
					return
				end)
			end
		end
	end)
end
