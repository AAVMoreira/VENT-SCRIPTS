local CFG = "V3NTHUBAllgear.json"
function _serializeValue(v, depth)
	depth = depth or 0
	if depth > 6 then return nil end
	local t = typeof(v)
	if t == "number" or t == "string" or t == "boolean" then
return v
	elseif t == "EnumItem" then
return v.Name
	elseif t == "table" then
local out = {}
for k2, v2 in pairs(v) do
local kt = type(k2)
if kt == "string" or kt == "number" then
local sv = _serializeValue(v2, depth + 1)
if sv ~= nil then out[k2] = sv end
end
end
return out
	end
	return nil
end
function saveCfg()
	local d = {}
	for k, v in pairs(St) do
		if type(k) == "string" then
			local sv = _serializeValue(v)
			if sv ~= nil then d[k] = sv end
		end
	end
	local ok, err = pcall(function()
		if not writefile then error("no writefile") end
		writefile(CFG, HttpService:JSONEncode(d))
	end)
	if not ok then
		warn("[V3NTHUB] saveCfg fail:", err)
	end
	return ok
end
function loadCfg()
	local ok, data = pcall(function()
if isfile and readfile then
if isfile(CFG) then
return HttpService:JSONDecode(readfile(CFG))
end
for _, old in ipairs({"RaraOnflop.json", "V3NTHUBHub_FullMenu_v1.json", "V3NTHUBHub_Config.json", "V3NTHUB.json"}) do
if isfile(old) then
local d = HttpService:JSONDecode(readfile(old))
pcall(function() writefile(CFG, HttpService:JSONEncode(d)) end)
return d
end
end
end
	end)
		if not (ok and type(data) == "table") then return false end
		local loadable = {
			toolAim = true, antiPaintball = true, antiGummy = true, antiBeeDisco = true, esp = true, mineESP = true, tracer = true, antiLag = true,
		destroySentry = true, spamLaser = true, spamPaint = true,
		guiLock = true, menuScale = true, menuOpen = true,
		_mainPos = true, _miniPos = true,
	}
	for k, v in pairs(data) do
		if loadable[k] then St[k] = v end
	end
	return true
end
