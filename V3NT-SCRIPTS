local antiBeeDiscoConn
local antiBeeDiscoLightingConn
local antiBeeDiscoLastSweep = 0

local function removeBeeDiscoEffect(obj)
	if not obj or not obj.Parent then return end
	local n = string.lower(obj.Name or "")
	if n:find("disco") or n:find("bee") or n == "blue" or n == "blur"
		or obj:IsA("BlurEffect") or obj:IsA("ColorCorrectionEffect")
		or obj:IsA("BloomEffect") or obj:IsA("SunRaysEffect")
		or obj:IsA("DepthOfFieldEffect") or obj:IsA("Atmosphere") then
		pcall(function() obj:Destroy() end)
	end
end

local function blockBeeSounds()
	local function check(container)
		for _, sound in ipairs(container:GetDescendants()) do
			if sound:IsA("Sound") then
				local n = string.lower(sound.Name or "")
				if n:find("bee") or n:find("buzz") then
					pcall(function() sound:Stop(); sound.Volume = 0 end)
				end
			end
		end
	end
	pcall(function() check(workspace) end)
	local scripts = LP:FindFirstChild("PlayerScripts")
	if scripts then pcall(function() check(scripts) end) end
end

local function sweepBeeDisco()
	if not St.antiBeeDisco then return end
	pcall(function()
		for _, obj in ipairs(Lighting:GetDescendants()) do removeBeeDiscoEffect(obj) end
		blockBeeSounds()
	end)
end

local function setAntiBeeDisco(on)
	St.antiBeeDisco = on and true or false
	if antiBeeDiscoConn then antiBeeDiscoConn:Disconnect(); antiBeeDiscoConn = nil end
	if antiBeeDiscoLightingConn then antiBeeDiscoLightingConn:Disconnect(); antiBeeDiscoLightingConn = nil end
	if St.antiBeeDisco then
		sweepBeeDisco()
		antiBeeDiscoLightingConn = Lighting.DescendantAdded:Connect(function(obj)
			if St.antiBeeDisco then removeBeeDiscoEffect(obj) end
		end)
		antiBeeDiscoConn = RS.Heartbeat:Connect(function()
			if not St.antiBeeDisco then return end
			local now = os.clock()
			if now - antiBeeDiscoLastSweep < 0.5 then return end
			antiBeeDiscoLastSweep = now
			sweepBeeDisco()
		end)
	end
	saveCfg()
end

